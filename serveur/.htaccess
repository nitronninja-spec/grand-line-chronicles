# Redirige tout le trafic vers https://grand-line-chronicles.fr (sans www)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://grand-line-chronicles.fr%{REQUEST_URI} [L,R=301]

# Pages : toujours revérifiées, pour qu'une mise à jour du site se voie tout de suite.
# _next/ : fichiers au nom unique (changent de nom à chaque export), gardés en cache un an.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
